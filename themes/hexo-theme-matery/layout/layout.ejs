<!DOCTYPE HTML>
<html lang="<%= config.language %>">
<%
function inlineJson(value) {
    return JSON.stringify(value).replace(/</g, '\\u003c');
}
var live2dBootstrap = { enabled: false };
if (config.live2d && config.live2d.enable) {
    var live2dMarkup = live2d();
    var live2dMatch = live2dMarkup.match(/<script src="([^"]+)"><\/script><script>L2Dwidget\.init\((\{[\s\S]*\})\);<\/script>/);
    if (live2dMatch) {
        live2dBootstrap = {
            enabled: true,
            src: live2dMatch[1],
            options: JSON.parse(live2dMatch[2])
        };
    }
}
%>
<%- partial('_partial/head') %>

<% if (theme.background.enable) { %>
   <%- partial('_partial/background') %>
<% } %>

<body>
    <%- partial('_partial/header') %>
    <%- body %>

    <%- partial('_partial/footer') %>

    <%- partial('_partial/search') %>
    <%- partial('_partial/back-top') %>

    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.materialize) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.masonry) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.aos) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.scrollProgress) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.lightgallery) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.effects) %>"></script>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.matery) %>"></script>

    <%- partial('_partial/baidu-analytics') %>
    <%- partial('_partial/baidu-push') %>
    <% if (theme.busuanziStatistics && theme.busuanziStatistics.enable) { %>
    <script async src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.busuanzi) %>"></script>
    <% } %>

    <% if (theme.tidio.enable) { %>
        <script src="//code.tidio.co/<%- theme.tidio.public_key %>.js"></script>
        <script>
            $(document).ready(function () {
                setInterval(change_Tidio, 50);
                function change_Tidio() {
                    var tidio=$("#tidio-chat iframe");
                    if(tidio.css("display")=="block"&& $(window).width()>977 ){
                        document.getElementById("tidio-chat-iframe").style.bottom= ($("div#backTop.top-scroll").css("display")=="none" &&$(window).width()>977)>0? "-40px" : ($("div.toc-title").length&&$(window).width()>977)>0?"<%if(theme.toc.showToggleBtn){%>85px<%}else{%>20px<%}%>":"20px";
                        document.getElementById("tidio-chat-iframe").style.right="-15px";
                        document.getElementById("tidio-chat-iframe").style.height=parseInt(tidio.css("height"))>=520?"520px":tidio.css("height");
                        document.getElementById("tidio-chat-iframe").style.zIndex="997";
                    }
                    else if(tidio.css("display")=="block"&&$(window).width()>601 &&$(window).width()<992 ){
                        document.getElementById("tidio-chat-iframe").style.bottom= ($("div#backTop.top-scroll").css("display")=="none" && 601< $(window).width()<992)>0? "-40px":"20px" ;
                        document.getElementById("tidio-chat-iframe").style.right="-15px";
                        document.getElementById("tidio-chat-iframe").style.zIndex="997";
                    }
                    else if(tidio.css("display")=="block"&&$(window).width()<601 && parseInt(tidio.css("height"))<230){
                        document.getElementById("tidio-chat-iframe").style.bottom= ($("div#backTop.top-scroll").css("display")=="none" && $(window).width()<601)>0? "-10px":"45px" ;
                        document.getElementById("tidio-chat-iframe").style.zIndex="997";
                    }
                    if( tidio.css("display")=="block"&&$(window).width()<601 && parseInt(tidio.css("height"))>=230){
                        document.getElementById("tidio-chat-iframe").style.zIndex="998";
                    }
                }
            });
        </script>
    <% } %>

    <% if (theme.daovoice.enable) { %>
    <script>
        (function (i, s, o, g, r, a, m) {
            i["DaoVoiceObject"] = r;
            i[r] = i[r] || function () {
                (i[r].q = i[r].q || []).push(arguments)
            }, i[r].l = 1 * new Date();
            a = s.createElement(o), m = s.getElementsByTagName(o)[0];
            a.async = 1;
            a.src = g;
            a.charset = "utf-8";
            m.parentNode.insertBefore(a, m)
        })(window, document, "script", ('https:' == document.location.protocol ? 'https:' : 'http:') +
            "//widget.daovoice.io/widget/6984b559.js", "daovoice")
        daovoice('init', {
            app_id: "<%- theme.daovoice.app_id %>"
        });
        daovoice('update');
    </script>
    <% } %>

	<% if (theme.tuxiaochao.enable) { %>
	    <div style="position:fixed;bottom:125px;right:9px;cursor: pointer;">
	        <a title="兔小巢" href="https://support.qq.com/products/<%- theme.tuxiaochao.productId %>"><img src="/medias/contact.png" alt="兔小巢"></a>
	    </div>
	<%}%>
    <% var ribbonSrc = theme.ribbon.clickChange ? theme.libs.js.ribbon : theme.libs.js.ribbonRefresh; %>
    <script>
        window.MateryEffects.init({
            effects: [
                {
                    name: 'clicklove',
                    enabled: <%= Boolean(theme.clicklove.enable) %>,
                    policy: 'desktop',
                    src: <%- inlineJson((theme.jsDelivr.url || '') + url_for(theme.libs.js.clicklove)) %>,
                    options: { maxHearts: 32 }
                },
                {
                    name: 'canvasNest',
                    enabled: <%= Boolean(theme.canvas_nest.enable) %>,
                    policy: 'desktop',
                    src: <%- inlineJson((theme.jsDelivr.url || '') + url_for(theme.libs.js.canvas_nest)) %>,
                    options: {
                        color: <%- inlineJson(String(theme.canvas_nest.color)) %>,
                        opacity: <%= Number(theme.canvas_nest.opacity) %>,
                        zIndex: <%= Number(theme.canvas_nest.zIndex) %>,
                        count: <%= Number(theme.canvas_nest.count) %>,
                        fps: 30
                    }
                },
                {
                    name: 'ribbon',
                    enabled: <%= Boolean(theme.ribbon.enable) %>,
                    policy: 'desktop',
                    src: <%- inlineJson((theme.jsDelivr.url || '') + url_for(ribbonSrc)) %>,
                    options: {
                        size: <%= Number(theme.ribbon.size) %>,
                        alpha: <%= Number(theme.ribbon.alpha) %>,
                        zIndex: <%= Number(theme.ribbon.zIndex) %>,
                        clickChange: <%= Boolean(theme.ribbon.clickChange) %>
                    }
                },
                {
                    name: 'ribbonDynamic',
                    enabled: <%= Boolean(theme.ribbon_dynamic.enable) %>,
                    policy: 'desktop',
                    src: <%- inlineJson((theme.jsDelivr.url || '') + url_for(theme.libs.js.ribbon_dynamic)) %>,
                    options: { fps: 30 }
                },
                {
                    name: 'cursor',
                    enabled: true,
                    policy: 'desktop',
                    src: <%- inlineJson(url_for('/js/cursor.js')) %>,
                    options: { maxParticles: 80 }
                }
            ],
            typed: window.materyTypedConfig || null,
            live2d: <%- inlineJson(live2dBootstrap) %>
        });
    </script>

    <% if (theme.instantpage.enable) { %>
    <script src="<%- theme.jsDelivr.url %><%- url_for(theme.libs.js.instantpage) %>" type="module"></script>
    <% } %>
</body>

</html>
